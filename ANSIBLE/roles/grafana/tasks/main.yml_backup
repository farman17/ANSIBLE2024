    - name: Add Grafana GPG key
      apt_key:
        url: https://packages.grafana.com/gpg.key
        state: present

    - name: Add Grafana APT repository
      apt_repository:
        repo: "deb https://packages.grafana.com/oss/deb stable main"
        state: present
        filename: grafana

    - name: Update APT cache
      apt:
        update_cache: yes

    - name: Install Grafana
      apt:
        name: grafana
        state: present

    - name: Enable and start Grafana service
      systemd:
        name: grafana-server
        enabled: yes
        state: started

#####TAMBAHAN UNTUK ADD DAASHBOARD####################
# Tambahkan setelah task install + datasource yang kamu punya
- name: Ensure dashboards dir exists
  file:
    path: /var/lib/grafana/dashboards
    state: directory
    mode: '0755'

- name: Download Node Exporter Full (1860)
  get_url:
    url: https://grafana.com/api/dashboards/1860/revisions/latest/download
    dest: /var/lib/grafana/dashboards/node-exporter-full.json
    mode: '0644'

- name: Download Prometheus 2.0 Stats (3662)
  get_url:
    url: https://grafana.com/api/dashboards/3662/revisions/latest/download
    dest: /var/lib/grafana/dashboards/prometheus-2-stats.json
    mode: '0644'

# Banyak dashboard dari grafana.com pakai placeholder ${DS_PROMETHEUS}
# Kita map ke datasource bernama "Prometheus" yang sudah kamu provision.
- name: Map ${DS_PROMETHEUS} to "Prometheus" in dashboards
  replace:
    path: "{{ item }}"
    regexp: '\$\{DS_PROMETHEUS\}'
    replace: 'Prometheus'
  loop:
    - /var/lib/grafana/dashboards/node-exporter-full.json
    - /var/lib/grafana/dashboards/prometheus-2-stats.json

- name: Provision dashboard provider
  copy:
    dest: /etc/grafana/provisioning/dashboards/dashboards.yml
    mode: '0644'
    content: |
      apiVersion: 1
      providers:
        - name: 'Default'
          orgId: 1
          folder: 'Default'
          type: file
          disableDeletion: false
          editable: true
          updateIntervalSeconds: 30
          options:
            path: /var/lib/grafana/dashboards
  notify: Restart grafana

