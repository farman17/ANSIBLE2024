#KAFKA
kafka_scala_version: "2.13"
kafka_version: "3.7.0"

kafka_user: kafka
kafka_group: kafka

kafka_install_dir: "/opt/kafka"
kafka_data_dir: "/var/lib/kafka"
kafka_log_dir: "/var/log/kafka"
kafka_config_dir: "/etc/kafka"

kafka_port: 9092
kafka_controller_port: 9093
kafka_heap_opts: "-Xms1g -Xmx1g"

kafka_cluster_id: ""
