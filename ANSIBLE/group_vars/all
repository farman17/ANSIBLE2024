# ==== Defaults: Kafka UI (override di play/host_vars bila perlu) ====

kafka_ui_user: kafka-ui
kafka_ui_port: 8080

kafka_ui_image_repo: provectuslabs/kafka-ui
kafka_ui_image_tag: v0.7.2
# — atau Kafbat terbaru
# kafka_ui_image_repo: "ghcr.io/kafbat/kafka-ui"
# kafka_ui_image_tag: "latest"

# Login ke Kafka UI
kafka_ui_auth_type: LOGIN_FORM
kafka_ui_auth_user: admin
kafka_ui_auth_password: farman123

# Dynamic config (untuk tombol "Configure")
kafka_ui_dynamic_enabled: true
kafka_ui_dynamic_config_dir: /var/lib/kafka-ui   # dipetakan ke /etc/kafkaui di container

# Daftar cluster awal (bisa banyak)
kafka_ui_clusters:
  - name: lab
    bootstrap_servers: "192.168.2.226:9092"

# Opsional: hash password user Linux kafka-ui (biarkan kosong untuk skip)
kafka_ui_password_hash: ~
#####################################################################################

#KAFKA-BACKEND
kafka_scala_version: "2.13"
kafka_version: "3.7.0"

kafka_user: kafka
kafka_group: kafka

kafka_install_dir: "/opt/kafka"
kafka_data_dir: "/var/lib/kafka"
kafka_log_dir: "/var/log/kafka"
kafka_config_dir: "/etc/kafka"

kafka_port: 9092
kafka_controller_port: 9093
kafka_heap_opts: "-Xms1g -Xmx1g"

kafka_cluster_id: ""
kafka_cluster_id_file: "{{ kafka_data_dir }}/cluster.id"

kafka_download_url: "https://archive.apache.org/dist/kafka/{{ kafka_version }}/kafka_{{ kafka_scala_version }}-{{ kafka_version }}.tgz"
kafka_archive_path: "/tmp/kafka_{{ kafka_scala_version }}-{{ kafka_version }}.tgz"

#KAFKA,SESUAIKAN DENGAN JUMLAH NODE NYA:
kafka_num_partitions: 1
kafka_offsets_rf: 1
kafka_txn_rf: 1
kafka_min_isr: 1
